auto lo
iface lo inet loopback

source /etc/network/interfaces.d/*

<%
import os

net_root = "/sys/class/net"
all_interfaces = [name for name in os.listdir(net_root) if name != "lo" and name.startswith(("en", "eth", "end", "lan", "wan"))]

dsa_interfaces = []
for name in all_interfaces:
	interface_path = os.path.join(net_root, name)
	for entry in os.listdir(interface_path):
		if entry.startswith("lower_") and entry[6:] in all_interfaces:
			dsa_interfaces.append(entry[6:])

# A DSA CPU/master interface exposes its switch user ports as lower_* links.
# Keep the port names for bridge-ports; the master is an internal uplink.
dsa_interfaces = sorted(set(dsa_interfaces))

if dsa_interfaces:
	management_interfaces = sorted(dsa_interfaces)
else:
	management_interfaces = sorted(
		name for name in all_interfaces
		if not any(entry.startswith("upper_") and entry[6:] in all_interfaces for entry in os.listdir(os.path.join(net_root, name)))
	)
	management_interfaces = management_interfaces[:1]
%>
% if management_interfaces:
auto vmbr0
iface vmbr0 inet dhcp
	bridge-ports ${" ".join(management_interfaces)}
	bridge-stp off
	bridge-fd 0
% endif

% for name in all_interfaces:
allow-hotplug ${name}
iface ${name} inet manual
% endfor
